{
  "name": "crm-backend",
  "version": "0.0.1",
  "description": "Backend del CRM (recorte del backend NestJS del ecommerce)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "dotenvx run -f .env.development.local -- nest start --watch --preserveWatchOutput",
    "start": "dotenvx run -f .env.development.local -- nest start",
    "start:prod": "dotenvx run -f .env.development.local -- node dist/src/main.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync-schema": "node scripts/sync-schema.js"
  },
  "dependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "11.4.5",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "8.20.0",
    "@types/uuid": "11.0.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "helmet": "8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slugify": "^1.6.9",
    "swagger-ui-express": "5.0.1",
    "uuid": "14.0.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.11.1",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
