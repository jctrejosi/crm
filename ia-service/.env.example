# IA Service (campañas) — variables de entorno de ejemplo
# Copia a `.env` para desarrollo local.

# DeepSeek (obligatoria para /generate)
# API key DEDICADA para ia-service (distinta a la del bot). Si se omite,
# el servicio usa DEEPSEEK_API_KEY como respaldo.
IA_SERVICE_DEEPSEEK_API_KEY=tu-api-key-ia-service
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60

# Puerto interno del servicio (contenedor: 8002)
IA_SERVICE_PORT=8002

# Orígenes CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Tuning
IA_SERVICE_MAX_TOKENS=3000
IA_SERVICE_MAX_TOOL_ROUNDS=6
