# ============================================================
# CRM (Mercaldas) — variables del contenedor de aplicación.
#
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
#   # edita dominios, ACME, contraseña del panel y secretos
#
# Este archivo NO se versiona (docker/.env está en .gitignore). Los dominios se
# pueden cambiar sin rebuild; las VITE_* van HORNEADAS en el panel ⇒ cambiar
# VITE_API_URL exige `docker compose ... build`.
# ============================================================

# ── Dominios (crea los registros DNS tipo A → IP del servidor ANTES de
#    arrancar: Let's Encrypt los valida por HTTP-01 en el puerto 80) ──
HOST_WEB=crm.mercaldas.jcti.xyz
HOST_API=crm-api.mercaldas.jcti.xyz

# ── TLS ──
# MODO EDGE COMPARTIDO (por defecto): el TLS lo termina el edge (otro Caddy que
# publica 80/443: ecommerce/docker/edge/), así que aquí va DESACTIVADO.
# MODO DIRECTO (este contenedor es el único en el servidor): TLS=true,
# ALLOW_INSECURE=false y PUBLIC_HTTP_PORT=80 / PUBLIC_HTTPS_PORT=443.
TLS=false
ALLOW_INSECURE=true
# Esquema público real (para CORS_ORIGIN derivado: http:// se rompería con el
# panel servido por https).
PUBLIC_SCHEME=https
ACME_EMAIL=admin@jcti.xyz

# ── Protección del panel (Basic Auth, defensa en profundidad sobre el login
#    JWT). Fail-closed: sin contraseña el contenedor NO arranca. ──
PROTECT_WEB=true
ADMIN_USER=admin
# Define UNA de las dos:
#   ADMIN_PASSWORD=una-clave-larga
#   ADMIN_PASSWORD_HASH=$2a$14$...   (caddy hash-password --plaintext '...')
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── URLs públicas horneadas en el panel (requieren rebuild al cambiarlas) ──
VITE_API_URL=https://crm-api.mercaldas.jcti.xyz
# Servicio de SMS de prueba (se llama desde el NAVEGADOR: debe ser HTTPS y
# permitir el origen del panel en su CORS). Déjalo vacío si no se usa.
# VITE_SMS_API_URL=https://sms.tudominio.com

# ── Puertos publicados en el host ──
# Puertos PROPIOS del CRM en loopback (nada más en el servidor debería usarlos).
# Solo el edge necesita abrir 80/443 en el firewall.
PUBLIC_HTTP_PORT=127.0.0.1:30280
PUBLIC_HTTPS_PORT=127.0.0.1:30281

# ── Secretos del backend ──
# Genera el JWT_SECRET con:  openssl rand -hex 32
# (obligatorio: sin él el backend no arranca)
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Base de datos ──
# El backend y las migraciones usan DATABASE_URL; por defecto apunta al servicio
# crm-postgres de este compose (red interna, nunca publicado a internet).
DATABASE_URL=postgres://postgres:postgres@crm-postgres:5432/crm
# Con NODE_ENV=production el backend activaría SSL si DB_SSL no fuese "false":
# la BD es local y sin TLS, así que debe quedarse en false.
DB_SSL=false
# Si cambias CRM_DB_PASSWORD, actualiza DATABASE_URL en la misma edición.
CRM_DB_USER=postgres
CRM_DB_PASSWORD=postgres
CRM_DB_NAME=crm
# Puerto SOLO en loopback del host (herramientas/ML nativos); nunca a internet.
CRM_DB_PORT=5437
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_PORT=5436

# ── ia-service (DeepSeek) ──
# Una de las dos basta; IA_SERVICE_DEEPSEEK_API_KEY tiene prioridad.
IA_SERVICE_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Rate limit del ia-service (peticiones/IP y ventana en segundos).
IA_RATE_LIMIT=20
IA_RATE_WINDOW=60

# ── Modelos de ML (clustering / xgboost / uplift) ──
# Corren DENTRO del contenedor de aplicación y escuchan en loopback
# (127.0.0.1:8010/8011/8012); el backend los llama por ahí. No se exponen a
# internet. CLUSTERING_API_KEY es la ADMIN_KEY de los tres: deben coincidir.
CLUSTERING_API_KEY=change-me
CLUSTERING_MODEL_NAME=seg_rfm_v1
XGBOOST_PROPENSITY_MODEL=prop_activo
UPLIFT_MODEL=uplift_dr_learner
# Las URLs son fijas (loopback dentro del contenedor): no hace falta definirlas.

# ── Borde (Caddy) ──
# CORS_ORIGIN vacío ⇒ se deriva de HOST_WEB. Nunca uses "*".
CORS_ORIGIN=
# Cuerpo máximo aceptado en el borde ("0" ⇒ sin límite).
MAX_REQUEST_BODY=50MB
# CSP a medida. Vacío/sin definir ⇒ política segura por defecto; "off" ⇒ sin
# cabecera (no recomendado).
# CSP_POLICY=
